{
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/app/main.py"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/digest/send",
            "schedule": "30 23 * * *"
        }
    ]
}